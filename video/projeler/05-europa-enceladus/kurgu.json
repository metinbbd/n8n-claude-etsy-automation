 "youtube": {
  "tr": {
   "baslik": "Europa ve Enceladus: Buzun Altındaki Okyanuslar | Gerçek NASA Görüntüleriyle Uzay Belgeseli",
   "aciklama": "Güneş Sistemi'nde yaşam arayışı bizi donmuş uyduların buzlu kabuğunun altına götürüyor. Bu belgeselde Jüpiter'in uydusu Europa'nın ve Satürn'ün uydusu Enceladus'un gizli okyanuslarını, Cassini'nin gayzerlerden aldığı örnekleri, hidrotermal bacaların yaşam için ne anlama geldiğini ve Europa Clipper ile JUICE görevlerinin neyi araştıracağını gerçek NASA görüntüleri ve animasyonlarıyla anlatıyoruz."
  },
  "en": {
   "baslik": "Europa and Enceladus: Oceans Beneath the Ice | Space Documentary with Real NASA Footage",
   "aciklama": "The search for life in our Solar System leads beneath the ice of frozen moons. This documentary explores the hidden oceans of Jupiter's moon Europa and Saturn's moon Enceladus, the samples Cassini tasted from the geysers, what hydrothermal vents mean for the search for life, and what NASA's Europa Clipper and ESA's JUICE will study, using real NASA footage and animations."
  },
